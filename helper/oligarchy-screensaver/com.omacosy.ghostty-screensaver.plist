<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.omacosy.ghostty-screensaver</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ye/.local/bin/omacosy-screensaver-idle</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>/tmp/omacosy-ss-idle.out</string>
  <key>StandardErrorPath</key><string>/tmp/omacosy-ss-idle.err</string>
</dict>
</plist>

# Herdr does not answer Neovim's underline probe. Ghostty's TERM
# skips that probe, so colored underlines survive inside a pane.
if [[ -n ${HERDR_ENV:-} ]]; then
  nvim() { TERM=xterm-ghostty command nvim "$@"; }
fi

#!/usr/bin/env bash
# One line for the right end of Herdr's tab row (ui.tab_bar_right, set by
# theme-pack): the focused pane's git branch with a mark when it has
# changes, and the 5-minute load average.
#
#   ⎇ herdr-hud* ╱ ▲ 1.8
#
# Herdr runs it every few seconds per window and keeps only the last line
# of output, so it stays cheap and prints nothing it does not know.
# Herdr hides the whole status area when it does not fit beside the tabs,
# so the line is kept short: no theme name (the colors say it), the last
# part of the branch name only, one decimal of load.
set -uo pipefail

parts=()

cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
if branch="$(git -C "$cwd" symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
  dirty=""
  if [ -n "$(git -C "$cwd" status --porcelain --untracked-files=no 2>/dev/null | head -n 1)" ]; then
    dirty="*"
  fi
  branch="${branch##*/}"
  [ "${#branch}" -gt 16 ] && branch="${branch:0:15}…"
  parts+=("⎇ ${branch}${dirty}")
fi

# "{ 1.82 1.70 1.60 }": after the brace come the 1-, 5- and 15-minute
# averages, so the 5-minute one is awk's third field.
load="$(sysctl -n vm.loadavg 2>/dev/null | awk '{printf "%.1f", $3}')"
[ -n "$load" ] && parts+=("▲ ${load}")

out=""
for p in "${parts[@]}"; do
  out="${out:+$out ╱ }$p"
done
printf '%s\n' "$out"

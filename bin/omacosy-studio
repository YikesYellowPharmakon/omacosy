#!/bin/zsh
# Ghostty runs this instead of a bare shell.
#
# A plain `herdr` attaches every terminal to one persistent session, so
# a new Ghostty window is another view of the window already open.
# Each window gets its own session, and that session stops when the
# window's client exits.
#
# Stock Ghostty starts in $HOME. Pane borders and the left sidebar
# follow the foreground program in every pane, including later splits.
HERDR=/opt/homebrew/bin/herdr
SESSION="ghostty-$$"
LOG="/tmp/omacosy-studio.log"

# Ghostty runs this for EVERY window. Without Herdr the last line fails at
# once and the window closes before anything can be read: no terminal at
# all on a machine where Herdr is not installed. A plain login shell there.
if [[ ! -x "$HERDR" ]]; then
  cd "$HOME" 2>/dev/null
  exec "${SHELL:-/bin/zsh}" -l
fi

# `session delete` refuses a session that is still running. Closing the
# window detaches the client, and the server takes a few tenths of a
# second to shut down after that, so an immediate delete failed and left
# the session behind. Wait for it to stop (up to 3 s), then delete.
stop_session() {
  trap - EXIT HUP TERM INT
  "$HERDR" session stop "$SESSION" >/dev/null 2>&1 || true
  local i
  for i in {1..30}; do
    session_running "$SESSION" || break
    sleep 0.1
  done
  "$HERDR" session delete "$SESSION" >/dev/null 2>&1 || true
}

session_running() {
  "$HERDR" session list --json 2>/dev/null |
    /usr/bin/python3 -c 'import json, sys
name = sys.argv[1]
s = [x for x in json.load(sys.stdin).get("sessions", []) if x.get("name") == name]
sys.exit(0 if s and s[0].get("running") else 1)' "$1"
}

# Windows that closed without cleaning up (a killed Ghostty, or the
# race above in an earlier version) leave stopped ghostty-<pid> sessions.
# Deleted only when stopped AND the window script that owned it (the pid
# in the name) is gone: a window opening right now has a session that is
# not running yet, and its script is still alive.
sweep_stopped_sessions() {
  local name
  "$HERDR" session list --json 2>/dev/null |
    /usr/bin/python3 -c 'import json, os, sys
for s in json.load(sys.stdin).get("sessions", []):
    name = s.get("name", "")
    pid = name[len("ghostty-"):]
    if not name.startswith("ghostty-") or s.get("running") or not pid.isdigit():
        continue
    try:
        os.kill(int(pid), 0)
        continue  # its window is still there
    except ProcessLookupError:
        print(name)
    except PermissionError:
        continue' |
    while IFS= read -r name; do
      "$HERDR" session delete "$name" >/dev/null 2>&1 || true
    done
}

label_panes() {
  /usr/bin/python3 - "$HERDR" "$SESSION" >>"$LOG" 2>&1 <<'PY'
import json, os, re, subprocess, sys, time

herdr, session = sys.argv[1], sys.argv[2]
SHELLS = {"zsh", "bash", "fish", "sh", "dash", "ksh", "nu"}
# Agents Herdr tracks itself through its own integrations. It refuses an
# agent report from another source for them, so a claim this watcher made
# earlier (zsh, before the agent started) stuck in the sidebar. For these
# the claim is released and the integration's own report shows instead.
NATIVE = {"claude", "codex", "pi", "omp", "copilot", "devin", "droid",
          "kimi", "opencode", "kilo"}
seen = {}
misses = 0

def call(*args):
    run = subprocess.run(
        [herdr, "--session", session, *args],
        capture_output=True,
        text=True,
    )
    if run.returncode != 0:
        return None
    raw = run.stdout
    start = raw.find("{")
    if start < 0:
        return None
    try:
        return json.loads(raw[start:])
    except json.JSONDecodeError:
        return None

def sanitize(name):
    text = re.sub(r"[^a-z0-9_-]", "-", (name or "").lower())
    text = re.sub(r"-+", "-", text).strip("-")
    if not text or not text[0].isalpha():
        text = "cmd"
    return text[:31]

def program(info):
    node = (info or {}).get("result", {}).get("process_info") or {}
    procs = node.get("foreground_processes") or []
    leader = node.get("foreground_process_group_id")
    shell_pid = node.get("shell_pid")
    chosen = next((p for p in procs if p.get("pid") == leader), None)
    if chosen is None and procs:
        chosen = procs[0]
    if not chosen:
        return "zsh", "idle", ""
    argv0 = chosen.get("argv0") or chosen.get("name") or ""
    base = os.path.basename(argv0) or chosen.get("name") or "zsh"
    if base.startswith("-"):
        base = base[1:]
    cmd = chosen.get("cmdline") or ""
    name = chosen.get("name") or ""
    if chosen.get("pid") == shell_pid or base in SHELLS:
        return sanitize(base or "zsh"), "idle", ""
    if name == "Python" or "Python.app" in cmd or "Python.framework" in cmd:
        return "python3", "working", short_cmd(cmd)
    return sanitize(base), "working", short_cmd(cmd)

def short_cmd(cmd):
    """The command line the sidebar shows under a busy pane: program name
    without its path, the rest as typed, cut to fit the sidebar."""
    words = (cmd or "").split()
    if not words:
        return ""
    words[0] = os.path.basename(words[0])
    if words[0].lower().startswith("python") and len(words) > 1:
        words = ["python3"] + [os.path.basename(words[1])] + words[2:]
    text = " ".join(words)
    return text if len(text) <= 22 else text[:21] + "…"

while True:
    data = call("pane", "list")
    if not data:
        misses += 1
        if misses > (8 if seen else 80):
            break
        time.sleep(0.4)
        continue
    misses = 0
    panes = data.get("result", {}).get("panes") or []
    alive = set()
    for pane in panes:
        pane_id = pane.get("pane_id")
        if not pane_id:
            continue
        alive.add(pane_id)
        info = call("pane", "process-info", "--pane", pane_id)
        if not info:
            continue
        label, state, running = program(info)
        if seen.get(pane_id) == (label, state, running):
            continue
        subprocess.run(
            [herdr, "--session", session, "pane", "rename", pane_id, label],
            capture_output=True,
            text=True,
        )
        if label in NATIVE:
            before = seen.get(pane_id)
            if before and before[0] not in NATIVE:
                subprocess.run(
                    [herdr, "--session", session, "pane", "release-agent", pane_id,
                     "--source", "omacosy", "--agent", before[0]],
                    capture_output=True,
                    text=True,
                )
            seen[pane_id] = (label, state, running)
            continue
        reported = subprocess.run(
            [
                herdr, "--session", session, "pane", "report-agent",
                "--source", "omacosy", "--agent", label, "--state", state,
                pane_id,
            ],
            capture_output=True,
            text=True,
        )
        # $cmd in the sidebar (theme-pack's agent rows); idle panes clear it.
        subprocess.run(
            [herdr, "--session", session, "pane", "report-metadata", pane_id,
             "--source", "omacosy",
             *(["--token", f"cmd={running}"] if running else ["--clear-token", "cmd"])],
            capture_output=True,
            text=True,
        )
        if reported.returncode == 0:
            seen[pane_id] = (label, state, running)
    for pane_id in list(seen):
        if pane_id not in alive:
            del seen[pane_id]
    time.sleep(0.4)
PY
}

cd "$HOME" || exit 1
setopt NO_HUP
sweep_stopped_sessions &!
# Start the watcher before the exit trap. A background job copies a
# trap that is already installed, and that trap would stop this
# window's session as soon as the watcher returned.
label_panes &
disown
# Run the trap while Herdr is still in the foreground. Without this,
# closing the window queues the trap until the client exits, and the
# client is what the trap is supposed to shut down.
setopt TRAPS_ASYNC
trap 'stop_session; exit 129' HUP
trap 'stop_session; exit 130' INT
trap 'stop_session; exit 143' TERM
trap stop_session EXIT
"$HERDR" --session "$SESSION"
rc=$?
stop_session
exit "$rc"

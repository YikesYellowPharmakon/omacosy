#!/bin/zsh
# One argv for Herdr. The launcher splits arguments on spaces, so the
# Neovim command line has to live in this script.
export TERM=xterm-ghostty
exec /opt/homebrew/bin/nvim \
  -c "luafile $HOME/.local/share/omacosy/share/skin-demo.lua" \
  "$HOME/.local/share/omacosy/share/skin-demo.py"

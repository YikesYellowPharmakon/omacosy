#!/usr/bin/env bash
# theme-set <name> [wallpaper] — switch desktop theme, optional wallpaper.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$REPO_DIR/themes"
CURRENT_DIR="$HOME/.config/omarchy/current"
STATE_DIR="$HOME/.local/state/omacosy"
BG_DIR="$STATE_DIR/bg"

case "${1:-list}" in
  list)
    current="$(basename "$(readlink "$CURRENT_DIR/theme" 2>/dev/null || true)")"
    for t in "$THEMES_DIR"/*/; do
      name="$(basename "$t")"
      n="$(find "$t/backgrounds" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.heic' \) 2>/dev/null | wc -l | tr -d ' ')"
      mark=""
      [ "$name" = "$current" ] && mark=" *"
      printf '%s  (%s walls)%s\n' "$name" "$n" "$mark"
    done
    exit 0
    ;;
esac

NAME="$1"
if [ ! -d "$THEMES_DIR/$NAME" ]; then
  echo "theme-set: unknown theme '$NAME'. Available:" >&2
  for t in "$THEMES_DIR"/*/; do basename "$t"; done >&2
  exit 1
fi

mkdir -p "$CURRENT_DIR" "$BG_DIR"
ln -sfn "$THEMES_DIR/$NAME" "$CURRENT_DIR/theme"

KORREN_CFG="$HOME/Library/Application Support/korren/config.toml"
case "$NAME" in
  tokyo-night|catppuccin|catppuccin-latte|gruvbox|solarized-dark|osaka-jade|daylight|everforest|rose-pine|nord|kanagawa) korren_theme="$NAME" ;;
  *) korren_theme="omarchy" ;;
esac
if [ -f "$KORREN_CFG" ]; then
  sed -i '' "s/^name = \".*\"/name = \"$korren_theme\"/" "$KORREN_CFG"
fi

resolve_wall() {
  local hint="${1:-}"
  if [ "$hint" = "__rain__" ] || [ "$hint" = "rain" ]; then
    if [ -f "$THEMES_DIR/$NAME/lock.png" ]; then
      echo "$THEMES_DIR/$NAME/lock.png"
      return
    fi
  fi
  if [ -n "$hint" ]; then
    if [ -f "$hint" ]; then
      echo "$(cd "$(dirname "$hint")" && pwd)/$(basename "$hint")"
      return
    fi
    if [ -f "$THEMES_DIR/$NAME/backgrounds/$hint" ]; then
      echo "$THEMES_DIR/$NAME/backgrounds/$hint"
      return
    fi
  fi
  if [ "$NAME" = "enter-the-matrix" ] && [ -z "$hint" ]; then
    if [ -f "$THEMES_DIR/$NAME/backgrounds/4-the-office.jpg" ]; then
      echo "$THEMES_DIR/$NAME/backgrounds/4-the-office.jpg"
      return
    elif [ -f "$THEMES_DIR/$NAME/backgrounds/06-office-crt.jpg" ]; then
      echo "$THEMES_DIR/$NAME/backgrounds/06-office-crt.jpg"
      return
    fi
  fi
  if [ -e "$BG_DIR/$NAME" ]; then
    local prev
    prev="$(readlink "$BG_DIR/$NAME" 2>/dev/null || true)"
    if [ -f "$prev" ]; then
      echo "$prev"
      return
    fi
  fi
  ls "$THEMES_DIR/$NAME"/backgrounds/* 2>/dev/null | head -1
}

WALL="$(resolve_wall "${2:-}")"
SKIP_WALL=0
if [ "$NAME" = "enter-the-matrix" ]; then
  rain_hint="${2:-}"
  if [ "$rain_hint" = "__rain__" ] || [ "$rain_hint" = "rain" ]; then
    SKIP_WALL=1
  fi
fi
if [ "$SKIP_WALL" = 0 ] && [ -n "$WALL" ] && [ -f "$WALL" ]; then
  ln -nsf "$WALL" "$STATE_DIR/background"
  ln -nsf "$WALL" "$BG_DIR/$NAME"
  if [ -x "$HOME/.local/bin/omacosy-helper" ]; then
    "$HOME/.local/bin/omacosy-helper" wallpaper "$WALL" >/dev/null 2>&1 || true
  else
    osascript - "$WALL" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  tell application "System Events" to tell every desktop to set picture to (item 1 of argv)
end run
APPLESCRIPT
  fi
fi

COLOR_MODE="${3:-}"
if [ -n "$COLOR_MODE" ]; then
  mkdir -p "$STATE_DIR/color"
  printf '%s\n' "$COLOR_MODE" > "$STATE_DIR/color/$NAME"
fi

if [ -x "$REPO_DIR/bin/theme-pack.py" ]; then
  # AeroSpace's PATH is only /usr/bin:/bin. /usr/bin/python3 has no
  # PyObjC, so the accent notification never leaves this process and
  # open windows keep the previous buttons and input color.
  THEME_PYTHON="/opt/homebrew/bin/python3"
  if [ ! -x "$THEME_PYTHON" ]; then
    THEME_PYTHON="$(command -v python3)"
  fi
  "$THEME_PYTHON" "$REPO_DIR/bin/theme-pack.py" apply "$THEMES_DIR/$NAME" "${WALL:-}" "${COLOR_MODE:-}" >/dev/null 2>&1 || true
fi

OMNIWM_SETTINGS="$HOME/.config/omniwm/settings.toml"
if [ -f "$OMNIWM_SETTINGS" ] && [ -f "$THEMES_DIR/$NAME/borders.sh" ]; then
  ACTIVE="$(grep -o 'ACTIVE_COLOR=0x[0-9a-fA-F]*' "$THEMES_DIR/$NAME/borders.sh" | head -1 | cut -d= -f2)"
  if [ -n "$ACTIVE" ]; then
    python3 - "$OMNIWM_SETTINGS" "$ACTIVE" <<'PY'
import re, sys
path, argb = sys.argv[1], sys.argv[2]
v = int(argb, 16)
r, g, b = (v >> 16 & 0xFF) / 255, (v >> 8 & 0xFF) / 255, (v & 0xFF) / 255
t = open(path).read()
sec = re.search(r'\[borders\.color\]\n(?:[a-z]+ = [0-9.]+\n)+', t)
if sec:
    new = f"[borders.color]\nalpha = 1.0\nblue = {b}\ngreen = {g}\nred = {r}\n"
    t = t[:sec.start()] + new + t[sec.end():]
    open(path, 'w').write(t)
PY
  fi
fi

if [ -x "$REPO_DIR/bin/matrix-rain-ctl" ]; then
  rain_hint="${2:-}"
  if [ "$NAME" = "enter-the-matrix" ]; then
    if [ "$rain_hint" = "__rain__" ] || [ "$rain_hint" = "rain" ]; then
      "$REPO_DIR/bin/matrix-rain-ctl" apply "$NAME" "__rain__" >/dev/null 2>&1 || true
    else
      "$REPO_DIR/bin/matrix-rain-ctl" apply "$NAME" "${WALL:-}" >/dev/null 2>&1 || true
    fi
  else
    "$REPO_DIR/bin/matrix-rain-ctl" apply "$NAME" >/dev/null 2>&1 || true
  fi
fi

# The bar watches this directory, not writes inside the theme. Touch it
# after the palette file exists so the battery icon picks up the new color
# on this switch, including when the symlink target did not change.
touch "$CURRENT_DIR"
if [ -f "$HOME/.config/ghostty/config" ]; then
  touch "$HOME/.config/ghostty/config"
fi

echo "theme: $NAME${WALL:+  wallpaper: $(basename "$WALL")}${COLOR_MODE:+  color: $COLOR_MODE}"

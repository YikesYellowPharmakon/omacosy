#!/bin/bash
# Stable code-signing identity for omacosy-bar so Accessibility
# grants survive rebuilds. Ad-hoc signatures change every compile and
# leave a checked-but-dead row in System Settings.
set -euo pipefail
BAR_APP="${1:-$HOME/.local/share/omacosy/omacosy-bar.app}"
SIGN_DIR="$HOME/.local/share/omacosy/signing"
P12="$SIGN_DIR/omacosy-codesign.p12"
CN="omacosy-codesign"
PASS="omacosy-bar-sign"

mkdir -p "$SIGN_DIR"
if ! security find-identity -p codesigning -v 2>/dev/null | grep -q "$CN"; then
  TMP=$(mktemp -d)
  cat >"$TMP/cert.cnf" <<'EOF'
[req]
distinguished_name = dn
x509_extensions = v3
prompt = no
[dn]
CN = omacosy-codesign
O = omacosy
[v3]
basicConstraints = CA:FALSE
keyUsage = digitalSignature
extendedKeyUsage = codeSigning
EOF
  openssl req -new -x509 -days 3650 -nodes \
    -newkey rsa:2048 \
    -keyout "$TMP/key.pem" \
    -out "$TMP/cert.pem" \
    -config "$TMP/cert.cnf"
  openssl pkcs12 -export \
    -inkey "$TMP/key.pem" -in "$TMP/cert.pem" \
    -out "$P12" -passout "pass:$PASS" -name "$CN"
  security import "$P12" \
    -k "$HOME/Library/Keychains/login.keychain-db" \
    -P "$PASS" -A -T /usr/bin/codesign -T /usr/bin/security >/dev/null
  # allow codesign to use the key without a GUI prompt
  security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "" \
    "$HOME/Library/Keychains/login.keychain-db" >/dev/null 2>&1 || true
  rm -rf "$TMP"
fi

codesign -f -s "$CN" --identifier com.omacosy.bar "$BAR_APP"
echo "signed $BAR_APP as $CN"
